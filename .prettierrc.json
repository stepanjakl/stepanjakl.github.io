{
	"semi": true,
	"singleQuote": true,
	"tabWidth": 4,
	"useTabs": true,
	"trailingComma": "none",
	"printWidth": 100,
	"arrowParens": "always",
	"endOfLine": "lf",
	"bracketSpacing": true,
	"bracketSameLine": true,
	"htmlWhitespaceSensitivity": "ignore",
	"singleAttributePerLine": true,
	"overrides": [
		{
			"files": "*.html",
			"options": {
				"printWidth": 200
			}
		},
		{
			"files": "*.css",
			"options": {
				"printWidth": 200
			}
		}
	]
}
